Dim As Double horas, minutos, segundos

INPUT "Digite a quantidade de tempo em horas: ", horas

minutos = horas * 60
segundos = horas * 3600

PRINT
PRINT "Valor original:"; horas; "hora(s)"
PRINT "Equivalente em minutos:"; minutos; "minuto(s)"
PRINT "Equivalente em segundos:"; segundos; "segundo(s)"
Sleep
